# Copy this file to ".env.local" and fill in the values from:
# Supabase dashboard > Project Settings > API (or "Data API" / "API Keys")
# Never commit .env.local. It is already listed in .gitignore.

# Your project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# The "anon" / "publishable" key. Safe to expose in the browser:
# the database security rules decide what it can do.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# The "service_role" / "secret" key. SERVER ONLY. Never put this in
# any variable starting with NEXT_PUBLIC_. Used for tracking lookups
# and rate limiting inside API routes.
SUPABASE_SERVICE_ROLE_KEY=

# Any long random string (32+ characters). Used to hash visitor IP
# addresses for rate limiting, so raw IPs are never stored.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SALT=
